<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="sale_res_config_settings_view_form_inherit" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <block name="quotation_order_setting_container" position="inside">
                <setting
                    id="sale_confirmation_groups"
                    company_dependent="1"
                    help="Groups defined here will be able to confirm sale orders. They are company-specific."
                >
                    <field
                        name="can_confirm_sales_groups_ids"
                        string="Can Confirm Sales"
                    />
                </setting>
            </block>
        </field>
    </record>
</odoo>
